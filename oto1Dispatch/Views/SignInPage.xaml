<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="oto1.SignInPage"
             Title="SignInPage">

    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="10,0">
            <ActivityIndicator x:Name="myactivityIndicator" IsVisible="True" IsRunning="False" Color="BlueViolet"/>
            <Label Text="خوش آمدید" FontSize="32" HorizontalOptions="Center" />
            <Entry x:Name="txtUsername" Placeholder="شناسه کاربر(شماره تلفن همراه یا رایانامه یا کد ملی)"  Text="postman1"/>
            <Entry x:Name="txtPassword" Placeholder="گذرواژه" IsPassword="True" Text="1234"/>
            <Button Text="ورود" x:Name="btnSignIn" Clicked="btnSignIn_Clicked" />
            <Label>
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text=" حساب کاربری نداری؟" />
                        <Span Text="ثبت نام" TextColor="Blue" TextDecorations="Underline">
                            <Span.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSignUpTapped"/>
                            </Span.GestureRecognizers>
                        </Span>
                        <Span Text=" کن" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>