<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dg="clr-namespace:Maui.DataGrid;assembly=Maui.DataGrid"
             x:Class="oto1.Vendor_Part"
             Title="موجودیها">

    <Grid RowDefinitions="70,*">

        <Button Text="Clear"
                Grid.Row="0" />
        <Button x:Name="btnAdd" Text="اضافه کردن"
                Grid.Row="0" Clicked="btnAdd_Clicked" />
        
        <dg:DataGrid x:Name="grdVendorPart"
             Grid.Row="1"
             ItemsSource="{Binding}">
            <dg:DataGrid.Columns>

                <dg:DataGridColumn Title="Id"
                       PropertyName="Id" />

                <dg:DataGridColumn Title="قطعه"
                       PropertyName="FName" />

                <dg:DataGridColumn Title="تعداد"
               PropertyName="Existance" />

                <dg:DataGridColumn Title="قیمت"
                       PropertyName="PriceAmount" />

                <dg:DataGridColumn Title="از تاریخ"
                       PropertyName="jalaliBeginDate"
                       Width="70" />

                <dg:DataGridColumn Title="تا تاریخ"
                       PropertyName="JalaliEndDate"
                       Width="70" />

                <dg:DataGridColumn Title="تخفیف٪"
                       PropertyName="DiscountPercent"
                       Width="70"
                       StringFormat="{}{0:0.00}" />

                <dg:DataGridColumn Title=""
                   PropertyName="ThumbnailPhotoFile"
                   SortingEnabled="False">

                    <dg:DataGridColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Aspect="AspectFit"
                   HeightRequest="60" />
                        </DataTemplate>
                    </dg:DataGridColumn.CellTemplate>

                </dg:DataGridColumn>


                <dg:DataGridColumn PropertyName="."
                   Width="0.75*"
                   FilteringEnabled="False">

                    <dg:DataGridColumn.CellTemplate>
                        <DataTemplate>
                            <Button Text="Edit"
                    BackgroundColor="LightSkyBlue"
                    Clicked="btnEdit_Clicked" />
                        </DataTemplate>
                    </dg:DataGridColumn.CellTemplate>

                </dg:DataGridColumn>


            </dg:DataGrid.Columns>

        </dg:DataGrid>

    </Grid>

</ContentPage>