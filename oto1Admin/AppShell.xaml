<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="oto1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:oto1"
    Shell.FlyoutBehavior="Flyout"
    FlowDirection="RightToLeft"
    >

    <Shell.ToolbarItems>
        <ToolbarItem IconImageSource="user1.png"  Order="Default" Priority="0"  x:Name="toolbaritemUser" Clicked="toolbaritemUser_Clicked" />
        <ToolbarItem Text="خروج"     Order="Secondary" Priority="10" x:Name="toolbaritemLogoff" Clicked="toolbaritemLogoff_Clicked"   />

    </Shell.ToolbarItems>

    <TabBar x:Name="tabbarShell" >

        <ShellContent  Title="خانه"  ContentTemplate="{DataTemplate local:HomePage}"  Icon="home1.png" Route="HomePage" x:Name="tabHome" />

        <ShellContent  Title="سفارشات"      Icon="basket1.png"     ContentTemplate="{DataTemplate local:Requests}"  x:Name="tabRequest"  />
        <ShellContent  Title="تولید محتوا"  Icon="management.png"  ContentTemplate="{DataTemplate local:Cms}"  x:Name="tabCms"  />
        <ShellContent  Title="مدیریت"       Icon="user2.png"       ContentTemplate="{DataTemplate local:MyProfile}"  x:Name="tabProfile"  />
        <ShellContent  Title="گزارشات"      Icon="report64.png"    ContentTemplate="{DataTemplate local:Reports}" x:Name="tabReport"  />

    </TabBar>

    <FlyoutItem Title="خانه"             Icon="home1.png">

        <ShellContent   Route="FlyoutHomeRoute"  Icon="home1.png"   x:Name="rightmenuHome"  />


    </FlyoutItem>
    <FlyoutItem Title="درباره..."
                Icon="oto1admin.png">
        <ShellContent  Title="پروفایل"   Icon="user2.png"     Route="FlyoutAboutRoute" x:Name="rightmenuAbout"  />
    </FlyoutItem>





</Shell>

