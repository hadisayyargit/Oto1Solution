<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="oto1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:oto1"
    Shell.FlyoutBehavior="Flyout"
    FlowDirection="RightToLeft"
    >

    <Shell.ToolbarItems   >
        <ToolbarItem IconImageSource="user1.png"  Order="Default" Priority="0"  x:Name="toolbaritemUser" Clicked="toolbaritemUser_Clicked" />
        <ToolbarItem Text="خروج"     Order="Secondary" Priority="10" x:Name="toolbaritemLogoff" Clicked="toolbaritemLogoff_Clicked"   />

    </Shell.ToolbarItems>
    
    <TabBar x:Name="tabbarShell" >

        <ShellContent  Title="خانه"  ContentTemplate="{DataTemplate local:HomePage}"  Icon="home1.png" Route="HomePage" x:Name="tabHome" />

        <Tab Icon="orders64.png" Title="خدمات"  x:Name="tabRequest">
            <local:Basket Title="سفارشات رسیده" IconImageSource="carmechanic.png" x:Name="tabNewRequests" />
            <ShellContent  Title="سفارشات باز"    Icon="car_xxl.png" x:Name="tabTodayRequests"  ContentTemplate="{DataTemplate local:Basket }"   />
        </Tab>

        <ShellContent  Title="پروفایل"   Icon="user2.png"      ContentTemplate="{DataTemplate local:MyProfile}"  x:Name="tabProfile"  />
        <ShellContent  Title="مدیریت"    Icon="management.png"  ContentTemplate="{DataTemplate local:MyProfile}"  x:Name="tabAdministration"  />
        <ShellContent  Title="گزارشات"   Icon="report64.png"   ContentTemplate="{DataTemplate local:Orders}"  />

    </TabBar>
    
    <FlyoutItem Title="خانه"
                Icon="home1.png">

        <ShellContent  ContentTemplate="{DataTemplate local:AppShell}" Route="HomePage"  Icon="home1.png"   />


    </FlyoutItem>
    <FlyoutItem Title="درباره..."
                Icon="oto1admin.png">
            <ShellContent  Title="پروفایل"   Icon="user2.png"      ContentTemplate="{DataTemplate local:MyProfile}"    />
    </FlyoutItem>





</Shell>

