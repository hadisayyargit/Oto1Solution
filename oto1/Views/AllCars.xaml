<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="oto1.AllCars"
             Title="AllCars">

    <ScrollView>
    <StackLayout Spacing="10">
        <ActivityIndicator x:Name="activityIndicator"
                   IsVisible="True"
                   IsRunning="False"
                   Color="Orange"
                  
 
                           />

        <Button x:Name="btnAllcars" Text="All Cars" Clicked="btnAllcars_Clicked"></Button>
        

        <CollectionView x:Name="collectionviewCars" SelectionChanged="collectionviewCars_SelectionChanged">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="0" HorizontalItemSpacing="0"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Margin="20" Padding="20" BackgroundColor="LightGray">
                        <Image Source="{Binding ThumbnailPhotoFile}" HeightRequest="60" WidthRequest="60" HorizontalOptions="Center"></Image>
                            <Label Text="{Binding FName}" FontSize="Medium"></Label>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </StackLayout>

    </ScrollView>
</ContentPage>