<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:oto1" 
             xmlns:models="clr-namespace:oto1.Models"
             x:Class="oto1.CascadeMenuContentView">

    <ContentView.Resources>
        <!-- اگر Converter را در App.xaml تعریف نکردید، اینجا اضافه کنید -->
    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="5" BackgroundColor="#14243A">

            <!-- هدر منو: نمایش عنوان انتخاب شده و دکمه Clear -->
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center" Margin="0,0,0,10">
                <Label Text="{Binding SelectedMenuTitle}"
                       TextColor="Yellow"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />

                <!-- دکمه پاک کردن فیلتر: متصل به ClearFilterCommand در MenuViewModel -->
                <Button Grid.Column="1"
                        Text="✕"
                        Command="{Binding ClearFilterCommand}"
                        IsVisible="{Binding SelectedMenuTitle, Converter={StaticResource StringNotNullOrEmptyConverter}}"
                        BackgroundColor="Transparent"
                        TextColor="Red"
                        FontSize="14"
                        HeightRequest="30"
                        WidthRequest="30"
                        Padding="0" />
            </Grid>

            <!-- درخت منو با استفاده از BindableLayout -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding MenuItems}" Spacing="5">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:MenuItemModel">
                        <VerticalStackLayout Spacing="2">

                            <!-- سطح ۱ (دکمه اصلی) -->
                            <Button Text="{Binding Title}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MenuViewModel}}, Path=ItemTappedCommand}"
                                    CommandParameter="{Binding}"
                                    TextColor="White"
                                    HorizontalOptions="Fill"
                                    HeightRequest="45"
                                    CornerRadius="6">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding HasChildren}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#1F3A5F" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding HasChildren}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#284464" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <!-- سطح ۲ (باز شدن با IsExpanded) -->
                            <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                               BindableLayout.ItemsSource="{Binding Children}"
                                               Padding="15,5,0,5"
                                               Spacing="3">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:MenuItemModel">
                                        <VerticalStackLayout Spacing="2">

                                            <Button Text="{Binding Title}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MenuViewModel}}, Path=ItemTappedCommand}"
                                                    CommandParameter="{Binding}"
                                                    BackgroundColor="#284464"
                                                    TextColor="White"
                                                    HorizontalOptions="Fill"
                                                    HeightRequest="40"
                                                    CornerRadius="4" />

                                            <!-- سطح ۳ -->
                                            <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                                               BindableLayout.ItemsSource="{Binding Children}"
                                                               Padding="15,5,0,5"
                                                               Spacing="3">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="models:MenuItemModel">
                                                        <Button Text="{Binding Title}"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MenuViewModel}}, Path=ItemTappedCommand}"
                                                                CommandParameter="{Binding}"
                                                                BackgroundColor="Transparent"
                                                                TextColor="#B0C4DE"
                                                                HorizontalOptions="Fill"
                                                                HeightRequest="30"
                                                                CornerRadius="4" />
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>

                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
