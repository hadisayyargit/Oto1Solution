<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:oto1.Models;assembly=oto1Lib"
             xmlns:local="clr-namespace:oto1"
             x:Class="oto1.CascadeMenuContentView"
             x:Name="thisView"
             FlowDirection="RightToLeft"
             x:DataType="models:MenuItemModel">

    <VerticalStackLayout Spacing="2">
        <!-- دکمه مربوط به آیتم جاری (BindingContext این کنترل خودِ MenuItemModel است) -->
        <Button Text="{Binding Title}"
                Command="{Binding Source={x:Reference thisView}, Path=ItemTappedCommand}"
                CommandParameter="{Binding .}"
                TextColor="White"
                HorizontalOptions="Fill"
                HeightRequest="40"
                CornerRadius="4">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding HasChildren}" Value="True">
                    <Setter Property="BackgroundColor" Value="#1F3A5F" />
                </DataTrigger>
                <DataTrigger TargetType="Button" Binding="{Binding HasChildren}" Value="False">
                    <Setter Property="BackgroundColor" Value="#284464" />
                </DataTrigger>
            </Button.Triggers>
        </Button>

        <!-- بخش فرزندان (تکرار خود ContentView برای سطوح بعدی) -->
        <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                             BindableLayout.ItemsSource="{Binding Children}"
                             Padding="15,5,0,5"
                             Spacing="3">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:MenuItemModel">
                    <!-- فراخوانی مجدد خودِ ContentView برای سطح بعدی و انتقال کامند از طریق Source -->
                    <local:CascadeMenuContentView 
                        BindingContext="{Binding .}"
                        ItemTappedCommand="{Binding Source={x:Reference thisView}, Path=ItemTappedCommand}" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
