<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:oto1.Models"
             x:Class="oto1.CascadeMenuContentView"
             x:Name="thisControl">

    <VerticalStackLayout BindingContext="{Binding Source={x:Reference thisControl}, Path=ViewModel}"
                         Spacing="4"
                         Padding="4">

        <!-- دکمه پاک کردن فیلتر -->
        <Button Text="حذف فیلتر" 
                Command="{Binding ClearFilterCommand}"
                BackgroundColor="#334155"
                TextColor="White"
                HeightRequest="35" />

        <!-- لیست تخت و پویا که تمام سطوح را تا هر عمقی نمایش می‌دهد -->
        <CollectionView ItemsSource="{Binding VisibleMenuItems}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MenuItemModel">
                    <!-- تورفتگی پویا بر اساس Level (مثلاً سطح ۰: بدون حاشیه، سطح ۱: ۱۵ واحد، سطح ۲: ۳۰ واحد) -->
                    <VerticalStackLayout Spacing="2" Margin="{Binding Level, Converter={StaticResource LevelToMarginConverter}}">

                        <Grid Padding="10" BackgroundColor="#1E293B">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Label Text="{Binding Title}" 
                                   TextColor="White" 
                                   VerticalOptions="Center" />

                            <Label Text="{Binding IsExpanded}" 
                                   TextColor="Yellow"
                                   VerticalOptions="Center"
                                   Grid.Column="1" />

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference thisControl}, Path=ViewModel.ItemTappedCommand}"
                                                      CommandParameter="{Binding}" />
                            </Grid.GestureRecognizers>
                        </Grid>

                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentView>
