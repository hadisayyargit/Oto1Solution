<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:oto1"
             xmlns:models="clr-namespace:oto1.Models"
             x:Class="oto1.Lubricant"
             Title="انتخاب قطعه"  
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" 
          ColumnDefinitions="0.5*,0.5*"    
          Padding="5"  
          Margin="5" 
          ColumnSpacing="5" 
          RowSpacing="5">

        <ActivityIndicator x:Name="activityIndicator" Grid.Row="0" Grid.ColumnSpan="2" IsVisible="True" IsRunning="False" Color="Orange" />

        <!-- ۱. اضافه شدن منوی درختی سفارشی در بالای صفحه -->
        <local:CascadeMenuContentView x:Name="menuView" Grid.Row="1" Grid.ColumnSpan="2"  HeightRequest="300" />



        <ImageButton Source="basket3.png" WidthRequest="50" HeightRequest="50" x:Name="btnAddToBasket" Clicked="btnAddToBasket_Clicked" Grid.Row="7" Grid.Column="0" />
        <ImageButton Source="eraser1.png" x:Name="btnClear" Grid.Row="7" Grid.Column="1" Clicked="btnClear_Clicked" />

    </Grid>
</ContentPage>
