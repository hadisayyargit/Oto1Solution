<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:persian="clr-namespace:MauiPersianToolkit.Controls;assembly=MauiPersianToolkit"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:oto1"
             xmlns:models="clr-namespace:oto1.Models;assembly=oto1Lib"
             xmlns:local="clr-namespace:oto1"
             x:Class="oto1.GetPart"
             x:Name="root"
             Title="انتخاب قطعه/روانکار/باتری/لاستیک"  
            
             FlowDirection="RightToLeft">
    <ScrollView>
    <Grid RowDefinitions="10,auto,auto,auto,auto,auto,auto,auto,*,auto" ColumnDefinitions="0.5*,0.5*"    Padding="5"  Margin="5" ColumnSpacing="5" RowSpacing="5"   >
        <ActivityIndicator x:Name="activityIndicator" Grid.Row="0" IsVisible="True"  IsRunning="False"      Color="Orange"  Grid.ColumnSpan="2"   />

            <VerticalStackLayout Padding="10" Spacing="5" x:Name="stacklayoutPartClass" Grid.Row="1" Grid.ColumnSpan="2">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="{Binding SelectedMenuTitle}"
                   TextColor="Blue"
                   FontSize="14"
                   Margin="0,0,0,10" />

         
                    <Button Text="✕" 
                    Command="{Binding ClearFilterCommand}"
                    IsVisible="{Binding HasSelectedMenuTitle}"
                           
                    BackgroundColor="Transparent"
                    TextColor="Red"
                    FontSize="14"
                    HeightRequest="30"
                    WidthRequest="30"
                    Padding="0" 
                            />
                    
                </HorizontalStackLayout>

  
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding MenuItems}" Spacing="5" x:Name="myCascadeMenu">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:MenuItemModel">
                            <local:CascadeMenuContentView 
                        BindingContext="{Binding .}"
                        ItemTappedCommand="{Binding Source={x:Reference root}, Path=BindingContext.ItemTappedCommand}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>




            <Picker Title="نام خودرو:"                     Grid.Row="2" Grid.Column="0" x:Name="pickerCar"  ItemsSource="{Binding cars}" ItemDisplayBinding="{Binding PName}"  SelectedIndexChanged="pickerCar_SelectedIndexChanged" ></Picker>
        <Picker Title="نام سازنده:"                    Grid.Row="2" Grid.Column="1" x:Name="pickerManufacturer" ItemsSource="{Binding Manufacturers}" ItemDisplayBinding="{Binding PName}" SelectedIndexChanged="pickerManufacturer_SelectedIndexChanged" ></Picker>

        <Label Text="انتخاب تامین کننده"  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" />
        <Grid  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" >
            <SearchBar x:Name="searchbarVendor" 
                         Placeholder="جستجو در نام تامین کننده..."
                         TextChanged="OnVendorSearchTextChanged"
                         HeightRequest="50"/>

            <!-- لیست نتایج که زیر سرچ‌بار باز می‌شود -->
            <CollectionView x:Name="cvVendorResults"
                              ItemsSource="{Binding FilteredVendors}"
                              IsVisible="False"
                              MaximumHeightRequest="200"
                              SelectionMode="Single"
                              SelectionChanged="OnVendorSelected"
                              BackgroundColor="White">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10">
                            <Label Text="{Binding PName}" FontSize="14" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>


        <Border Grid.Row="4" Grid.ColumnSpan="2" IsVisible="False" x:Name="frameLubricant" >
            <HorizontalStackLayout Padding="5">
            <Entry  Placeholder="درجه گرانروی(ویسکوزیته):" x:Name="txtViscosity"></Entry>
            <Entry  Placeholder="سطح کارایی:"              x:Name="txtPerformanceLevel"></Entry>
            </HorizontalStackLayout>
        </Border>

        <Border Grid.Row="4" Grid.ColumnSpan="2" IsVisible="True" x:Name="frameBattery" >
            <HorizontalStackLayout Padding="5" >
                <Entry  Placeholder="ولتاژ" x:Name="txtVoltage" WidthRequest="200"></Entry>
                <Entry  Placeholder="آمپراژ:"              x:Name="txtAmperage"></Entry>
            </HorizontalStackLayout>
        </Border>
        <Border Grid.Row="4" Grid.ColumnSpan="2" IsVisible="False" x:Name="frameTire" >
            <HorizontalStackLayout Padding="5">
                <Entry  Placeholder="سال ساخت:"    x:Name="txtTireYear" WidthRequest="100"></Entry>
                <Entry  Placeholder="اندازه رینگ:" x:Name="txtTireRingSize" WidthRequest="100"></Entry>
                <Entry  Placeholder="پهنا:"        x:Name="txtTireWheels" ></Entry>
            </HorizontalStackLayout>
        </Border>
        
        <Entry  Placeholder="نام محصول:"               Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" x:Name="txtPartName"></Entry>
        <Entry  Placeholder="کد محصول:"                Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" x:Name="txtPartCode"></Entry>
        <Entry  Placeholder="ویژگی:"                   Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="txtAttribute"></Entry>

        <Button  Text="فیلترها رو پاک کن" x:Name="btnClear"  Grid.Row="7" Grid.Column="1"  Clicked="btnClear_Clicked"></Button>
        <Button Text="پیدا کن" x:Name="btnSearch"      Grid.Row="7" Grid.Column="0"  Clicked="btnSearch_Clicked"  />


            <CollectionView x:Name="collectionviewProducts" Grid.Row="8" Grid.ColumnSpan="2" SelectionMode="None" RemainingItemsThreshold="5"
RemainingItemsThresholdReached="collectionviewProducts_RemainingItemsThresholdReached" >
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="8" HorizontalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="4">
                            <Grid RowDefinitions="*,30,30,30,30" ColumnDefinitions=".3*,.7*"  BackgroundColor="Transparent"  Padding="5" Margin="5" >
                            <Image Source="{Binding PhotoFileName}" Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" BackgroundColor="Transparent" VerticalOptions="Start" ></Image>
                            <Label Text="{Binding PName}"           Grid.Row="0" Grid.Column="1" FontSize="Small" TextColor="Blue"></Label>
                            <Label Text="{Binding VendorName}"      Grid.Row="1" Grid.Column="1" FontSize="Micro" ></Label>
                            <Label Text="{Binding PriceAmount}"     Grid.Row="2" Grid.Column="1" FontSize="Small" TextDecorations="Strikethrough"  FontAttributes="Italic"  ></Label>
                            <Label Text="{Binding NetAmount}"       Grid.Row="3" Grid.Column="1" FontSize="Medium"  TextColor="DarkBlue"  FontAttributes="Bold"></Label>


                            <StackLayout Orientation="Horizontal" Grid.Row="4" Grid.Column="1"  >
                                <Button Text="+" HeightRequest="40" x:Name="btnAdd" Command="{Binding IncreaseCommand}"></Button>
                                <Label Text="{Binding Quantity}" x:Name="lblQuantity" VerticalOptions="Center" WidthRequest="20" HorizontalTextAlignment="Center"></Label>
                                <Button Text="-" HeightRequest="40" x:Name="btnSubtract" Command="{Binding DecreaseCommand}" ></Button>
                            </StackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ImageButton Source="basket3.png" WidthRequest="50" Grid.Row="9" Grid.Column="1"  x:Name="btnAddToBasket"  Clicked="btnAddToBasket_Clicked"   />
        <ImageButton Source="rightback.png" WidthRequest="50" Grid.Row="9" Grid.Column="0"  x:Name="btnBeforeStep"  Clicked="btnBeforeStep_Clicked"   />

    </Grid>

</ScrollView>

</ContentPage>
