<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:oto1.Models;assembly=oto1Lib"
             xmlns:local="clr-namespace:oto1"
             x:Class="oto1.GetPart"
             x:Name="root"
             Title="انتخاب قطعه/روانکار/باتری/لاستیک"  
             FlowDirection="RightToLeft">

    <!-- استفاده از Grid اصلی برای تقسیم صفحه به دو بخش: محتوا و دکمه‌های ثابت -->
    <Grid RowDefinitions="*, Auto" Padding="5">

        <!-- بخش اول: محتوای اسکرول‌شونده -->
        <ScrollView Grid.Row="0">
            <Grid RowDefinitions="30,auto,auto,auto,auto,auto,auto,auto,*,auto" 
                  ColumnDefinitions="0.5*,0.5*" 
                  Padding="5" 
                  Margin="5" 
                  ColumnSpacing="5" 
                  RowSpacing="5">

                <ActivityIndicator x:Name="activityIndicator" Grid.Row="0" IsVisible="True" IsRunning="False" Color="Orange" Grid.ColumnSpan="2" />

                <VerticalStackLayout Padding="10" Spacing="5" x:Name="stacklayoutPartClass" Grid.Row="1" Grid.ColumnSpan="2">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="{Binding SelectedMenuTitle}" TextColor="Blue" FontSize="14" Margin="0,0,0,10" />
                        <Button Text="✕" Command="{Binding ClearFilterCommand}" IsVisible="{Binding HasSelectedMenuTitle}" BackgroundColor="Transparent" TextColor="Red" FontSize="14" HeightRequest="30" WidthRequest="30" Padding="0" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout 
    x:Name="myCascadeMenu"
    Spacing="5" 
    BindableLayout.ItemsSource="{Binding MenuItems}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MenuItemModel">
                                <local:CascadeMenuContentView 
                BindingContext="{Binding .}"
                ItemTappedCommand="{Binding Source={x:Reference root}, Path=BindingContext.ItemTappedCommand}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Label Text="انتخاب تامین کننده" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" />
                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                    <SearchBar x:Name="searchbarVendor" Placeholder="جستجو در نام تامین کننده..." TextChanged="OnVendorSearchTextChanged" HeightRequest="50"/>
                    <CollectionView x:Name="cvVendorResults" ItemsSource="{Binding FilteredVendors}" IsVisible="False" MaximumHeightRequest="200" SelectionMode="Single" SelectionChanged="OnVendorSelected" BackgroundColor="White">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10">
                                    <Label Text="{Binding PName}" FontSize="14" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <Picker Title="نام سازنده:" Grid.Row="3" Grid.Column="0" x:Name="pickerManufacturer" ItemsSource="{Binding Manufacturers}" ItemDisplayBinding="{Binding PName}" SelectedIndexChanged="pickerManufacturer_SelectedIndexChanged" />
                <Entry Placeholder="کد محصول:" Grid.Row="3" Grid.Column="1" x:Name="txtPartCode" />

                <Entry Placeholder="نام محصول:" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="txtPartName" />
                <Entry Placeholder="ویژگی:" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" x:Name="txtAttribute" />

                <!-- Borderها (Battery, Tire, Lubricant) -->
                <Border Grid.Row="6" Grid.ColumnSpan="2" IsVisible="False" x:Name="frameLubricant">
                    <HorizontalStackLayout Padding="5">
                        <Entry Placeholder="درجه گرانروی:" x:Name="txtViscosity" MaxLength="10" />
                        <Entry Placeholder="سطح کارایی:" x:Name="txtPerformanceLevel" />
                    </HorizontalStackLayout>
                </Border>

                <Border Grid.Row="6" Grid.ColumnSpan="2" IsVisible="True" x:Name="frameBattery">
                    <HorizontalStackLayout Padding="5">
                        <Entry Placeholder="ولتاژ" x:Name="txtVoltage" WidthRequest="100" />
                        <Entry Placeholder="آمپراژ:" x:Name="txtAmperage" />
                    </HorizontalStackLayout>
                </Border>

                <Border Grid.Row="6" Grid.ColumnSpan="2" IsVisible="False" x:Name="frameTire">
                    <HorizontalStackLayout Padding="5">
                        <Entry Placeholder="سال ساخت:" x:Name="txtTireYear" WidthRequest="80" />
                        <Entry Placeholder="رینگ:" x:Name="txtTireRingSize" WidthRequest="80" />
                        <Entry Placeholder="پهنا:" x:Name="txtTireWheels" />
                    </HorizontalStackLayout>
                </Border>

                <Button Text="فیلترها رو پاک کن" x:Name="btnClear" Grid.Row="7" Grid.Column="1" Clicked="btnClear_Clicked" />
                <Button Text="پیدا کن" x:Name="btnSearch" Grid.Row="7" Grid.Column="0" Clicked="btnSearch_Clicked" />

                <CollectionView x:Name="collectionviewProducts" Grid.Row="8" Grid.ColumnSpan="2" SelectionMode="None" RemainingItemsThreshold="5" RemainingItemsThresholdReached="collectionviewProducts_RemainingItemsThresholdReached">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="2" HorizontalItemSpacing="2" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="5">
                                <Grid RowDefinitions="*,30,30,40,30" ColumnDefinitions=".3*,.7*" BackgroundColor="Transparent" ColumnSpacing="5" Padding="5" Margin="5">
                                    <Image Source="{Binding PhotoFileName}" Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" BackgroundColor="Transparent" VerticalOptions="Start" />
                                    <Label Text="{Binding PName}" Grid.Row="0" Grid.Column="1" FontSize="Small" TextColor="Blue" />
                                    <Label Text="{Binding VendorName}" Grid.Row="1" Grid.Column="1" FontSize="Micro" />
                                    <Label Text="{Binding PriceAmount}" Grid.Row="2" Grid.Column="1" FontSize="Small" TextDecorations="Strikethrough" FontAttributes="Italic" />
                                    <Label Text="{Binding NetAmount}" Grid.Row="3" Grid.Column="1" FontSize="Medium" TextColor="DarkBlue" FontAttributes="Bold" />
                                    <StackLayout Orientation="Horizontal" Grid.Row="4" Grid.Column="1">
                                        <Button Text="+" HeightRequest="40" Command="{Binding IncreaseCommand}" />
                                        <Label Text="{Binding Quantity}" VerticalOptions="Center" WidthRequest="20" HorizontalTextAlignment="Center" />
                                        <Button Text="-" HeightRequest="40" Command="{Binding DecreaseCommand}" />
                                    </StackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </ScrollView>

        <!-- بخش دوم: دکمه‌های ثابت در پایین صفحه -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Padding="10" ColumnSpacing="10" BackgroundColor="#F8F8F8">
            <ImageButton Source="basket3.png" 
                         Grid.Column="0"
                         WidthRequest="60" 
                         HeightRequest="50"
                         x:Name="btnAddToBasket" 
                         Clicked="btnAddToBasket_Clicked" />

            <ImageButton Source="rightback.png" 
                         Grid.Column="1"
                         WidthRequest="60" 
                         HeightRequest="50"
                         x:Name="btnBeforeStep" 
                         Clicked="btnBeforeStep_Clicked" />
        </Grid>

    </Grid>
</ContentPage>
