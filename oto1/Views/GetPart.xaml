<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:oto1"
             xmlns:models="clr-namespace:oto1.Models;assembly=oto1Lib"
             xmlns:local="clr-namespace:oto1"
             x:Class="oto1.GetPart"
             x:Name="root"
             Title="انتخاب قطعه/روانکار/باتری/لاستیک"  
            
             FlowDirection="RightToLeft">
   
    <Grid RowDefinitions="10,auto,auto,auto,auto,auto,auto,auto,*,auto" ColumnDefinitions="0.5*,0.5*"    Padding="5"  Margin="5" ColumnSpacing="5" RowSpacing="5"   >
        <ActivityIndicator x:Name="activityIndicator" Grid.Row="0" IsVisible="True"  IsRunning="False"      Color="Orange"  Grid.ColumnSpan="2"   />

        <ScrollView Grid.Row="1" Grid.ColumnSpan="2">
            <VerticalStackLayout Padding="10" Spacing="5">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <!-- نمایش عنوان انتخاب شده -->
                    <Label Text="{Binding SelectedMenuTitle}"
                   TextColor="Yellow"
                   FontSize="14"
                   Margin="0,0,0,10" />

                    <!-- دکمه کوچک پاک کردن فیلتر -->
                    <Button Text="✕" 
                    Command="{Binding ClearFilterCommand}"
                    IsVisible="{Binding SelectedMenuTitle, Converter={StaticResource StringNotNullOrEmptyConverter}}"
                    BackgroundColor="Transparent"
                    TextColor="Red"
                    FontSize="14"
                    HeightRequest="30"
                    WidthRequest="30"
                    Padding="0" />
                </HorizontalStackLayout>

                <!-- لیست اصلی سطح صفر که از ContentView استفاده می‌کند -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding MenuItems}" Spacing="5">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:MenuItemModel">
                            <local:CascadeMenuContentView 
                        BindingContext="{Binding .}"
                        ItemTappedCommand="{Binding Source={x:Reference root}, Path=BindingContext.ItemTappedCommand}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>



        <Picker Title="نام خودرو:"                     Grid.Row="2" Grid.Column="0" x:Name="pickerCar"  ItemsSource="{Binding cars}" ItemDisplayBinding="{Binding FName}"  SelectedIndexChanged="pickerCar_SelectedIndexChanged" ></Picker>
        <Picker Title="نام سازنده:"                    Grid.Row="2" Grid.Column="1" x:Name="pickerManufacturer" ItemsSource="{Binding Manufacturers}" ItemDisplayBinding="{Binding FName}" SelectedIndexChanged="pickerManufacturer_SelectedIndexChanged" ></Picker>
        <Picker Title="تامین کننده:"                   Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="pickerVendor" ItemsSource="{Binding Vendors}" ItemDisplayBinding="{Binding FName}" SelectedIndexChanged="pickerVendor_SelectedIndexChanged" ></Picker>

        <Border Grid.Row="4" Grid.ColumnSpan="2" IsVisible="False" x:Name="frameLubricant" >
            <HorizontalStackLayout Padding="5">
            <Entry  Placeholder="درجه گرانروی(ویسکوزیته):" x:Name="txtViscosity"></Entry>
            <Entry  Placeholder="سطح کارایی:"              x:Name="txtPerformanceLevel"></Entry>
            </HorizontalStackLayout>
        </Border>

        <Border Grid.Row="4" Grid.ColumnSpan="2" IsVisible="True" x:Name="frameBattery" >
            <HorizontalStackLayout Padding="5" >
                <Entry  Placeholder="ولتاژ" x:Name="txtVoltage" WidthRequest="200"></Entry>
                <Entry  Placeholder="آمپراژ:"              x:Name="txtAmperage"></Entry>
            </HorizontalStackLayout>
        </Border>
        <Border Grid.Row="4" Grid.ColumnSpan="2" IsVisible="False" x:Name="frameTire" >
            <HorizontalStackLayout Padding="5">
                <Entry  Placeholder="سال ساخت:" x:Name="txtTireYear" WidthRequest="100"></Entry>
                <Entry  Placeholder="اندازه رینگ:" x:Name="txtTireRingSize" WidthRequest="100"></Entry>
                <Entry  Placeholder="پهنا:"              x:Name="txtTireWheels" ></Entry>
            </HorizontalStackLayout>
        </Border>
        
        <Picker Title="نام محصول:"                     Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" x:Name="pickerProduct" ItemsSource="{Binding Products}" ItemDisplayBinding="{Binding FName}" SelectedIndexChanged="pickerProduct_SelectedIndexChanged" ></Picker>
        <Entry  Placeholder="کد محصول:"                Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" x:Name="txtPartCode"></Entry>
        <Entry  Placeholder="ویژگی:"                   Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="txtAttribute"></Entry>

        <Button  Text="بازگشت" x:Name="btnBeforeStep"  Grid.Row="7" Grid.Column="1"  Clicked="btnBeforeStep_Clicked"></Button>
        <Button Text="پیدا کن" x:Name="btnSearch"      Grid.Row="7" Grid.Column="0"  Clicked="btnSearch_Clicked"  />


        <CollectionView x:Name="collectionviewProducts" Grid.Row="8" Grid.ColumnSpan="2" SelectionMode="None" >
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="8" HorizontalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="4">
                        <Grid RowDefinitions="*,30,30,30,30" ColumnDefinitions=".3*,.7*"  BackgroundColor="MistyRose">
                            <Image Source="{Binding PhotoFileName}" Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" BackgroundColor="Transparent" VerticalOptions="Start" ></Image>
                            <Label Text="{Binding FName}"           Grid.Row="0" Grid.Column="1" FontSize="Small" TextColor="Blue"></Label>
                            <Label Text="{Binding VendorName}"      Grid.Row="1" Grid.Column="1" FontSize="Micro" ></Label>
                            <Label Text="{Binding PriceAmount}"     Grid.Row="2" Grid.Column="1" FontSize="Small" TextDecorations="Strikethrough"  FontAttributes="Italic"  ></Label>
                            <Label Text="{Binding NetAmount}"       Grid.Row="3" Grid.Column="1" FontSize="Medium"  TextColor="DarkBlue"  FontAttributes="Bold"></Label>


                            <StackLayout Orientation="Horizontal" Grid.Row="4" Grid.Column="1" >
                                <Button Text="+" HeightRequest="40" x:Name="btnAdd" Command="{Binding IncreaseCommand}"></Button>
                                <Label Text="{Binding Quantity}" x:Name="lblQuantity" VerticalOptions="Center"></Label>
                                <Button Text="-" HeightRequest="40" x:Name="btnSubtract" Command="{Binding DecreaseCommand}" ></Button>
                            </StackLayout>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ImageButton Source="basket3.png" WidthRequest="50" Grid.Row="9" Grid.Column="0"  x:Name="btnAddToBasket"  Clicked="btnAddToBasket_Clicked"   />
        <ImageButton Source="eraser1.png" x:Name="btnClear" Grid.Row="9" Grid.Column="1"  Clicked="btnClear_Clicked"/>

    </Grid>



</ContentPage>
