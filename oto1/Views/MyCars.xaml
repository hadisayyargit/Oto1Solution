<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="oto1.MyCars"
             Title="ماشین‌های من" 
             FlowDirection="RightToLeft"
             BackgroundColor="#F5F5F5">
    <!-- یک پس‌زمینه خاکستری بسیار روشن برای تفکیک بهتر -->

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ۱. بخش فرم ورودی (Upper Section) -->
        <Frame Grid.Row="0" Margin="10" Padding="15" CornerRadius="15" HasShadow="True" BackgroundColor="White">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="Auto, *" RowSpacing="10" ColumnSpacing="10">

                <Label Text="نام خودرو:" Grid.Row="0" Grid.Column="0" VerticalOptions="Center" FontAttributes="Bold" TextColor="#333"/>
                <Picker x:Name="pickerCar" Title="انتخاب خودرو..." Grid.Row="0" Grid.Column="1" 
                        ItemDisplayBinding="{Binding PName}" />

                <Label Text="پلاک:" Grid.Row="1" Grid.Column="0" VerticalOptions="Center" FontAttributes="Bold" TextColor="#333"/>
                <Entry Placeholder="مثلاً: ۱۲ ج ۳۴۵" Grid.Row="1" Grid.Column="1" x:Name="txtPlaque" />

                <!-- دکمه‌ها در یک ردیف -->
                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" HorizontalOptions="Center" Spacing="20" Margin="0,10,0,0">
                    <Button Text="پاک کردن" x:Name="btnClear" Clicked="btnClear_Clicked" 
                            BackgroundColor="#E74C3C" TextColor="White" WidthRequest="120" CornerRadius="10"/>
                    <Button Text="ثبت/بروزرسانی" x:Name="btnUpdate" Clicked="btnUpdate_Clicked" 
                            BackgroundColor="#2C3E50" TextColor="White" WidthRequest="120" CornerRadius="10"/>
                </HorizontalStackLayout>
            </Grid>
        </Frame>

        <!-- ۲. بخش نمایش لیست (Middle Section) -->
        <CollectionView x:Name="collectionviewCars" 
                        Grid.Row="1" 
                        SelectionChanged="collectionviewCars_SelectionChanged" 
                        SelectionMode="Single"
                        Margin="5">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="10" HorizontalItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="15" HasShadow="True" Padding="0" IsClippedToBounds="True" BorderColor="#DDD">
                        <VerticalStackLayout Spacing="0">
                            <!-- تصویر خودرو -->
                            <Frame Padding="0" IsClippedToBounds="True" CornerRadius="15,15,0,0">
                                <Image Source="{Binding ThumbnailPhotoString}" 
                                       Aspect="AspectFill"
                                       HeightRequest="120" 
                                       WidthRequest="150" 
                                       HorizontalOptions="Center" />
                            </Frame>

                            <!-- اطلاعات خودرو -->
                            <VerticalStackLayout Padding="10" Spacing="5">
                                <Label Text="{Binding PName}" 
                                       FontSize="Medium" 
                                       FontAttributes="Bold" 
                                       HorizontalOptions="Center"
                                       TextColor="#2C3E50"/>

                                <Frame Padding="5,2" BackgroundColor="#2C3E50" CornerRadius="5" HorizontalOptions="Center">
                                    <Label Text="{Binding Plaque}" 
                                           FontSize="Small" 
                                           TextColor="White" 
                                           HorizontalOptions="Center"/>
                                </Frame>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ۳. لودینگ (Overlay) -->
        <ActivityIndicator x:Name="activityIndicator"
                           Grid.RowSpan="3"
                           IsVisible="False"
                           IsRunning="False"
                           Color="#2C3E50"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           ZIndex="100"/>

    </Grid>
</ContentPage>
