<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="oto1.FlyoutPageMain"
             xmlns:local="clr-namespace:oto1"
             Title="mFlyoutPage"
            FlyoutLayoutBehavior="Popover"
             FlowDirection="RightToLeft"
            >

    <FlyoutPage.Flyout>
        <local:FlyoutPopupPage  x:Name="flyoutPage" />
    </FlyoutPage.Flyout>
    <FlyoutPage.Detail>
        <NavigationPage>
            <x:Arguments>
                <local:MainPage />
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>
</FlyoutPage>