		<VisualStudio>
			<UserProperties XamarinHotReloadDebuggerTimeoutExceptionoto1HideInfoBar="True" XamarinHotReloadGenericExceptionInfoBaroto1HideInfoBar="True" />
		</VisualStudio>
	</ProjectExtensions>

